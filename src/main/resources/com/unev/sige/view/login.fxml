<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.unev.sige.controller.LoginController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <Label text="SIGE - Sistema Integral de Gestión Escolar">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <Label text="Iniciar sesión" />

    <GridPane hgap="10.0" vgap="12.0">
        <columnConstraints>
            <javafx.scene.layout.ColumnConstraints minWidth="120.0" />
            <javafx.scene.layout.ColumnConstraints minWidth="220.0" />
        </columnConstraints>

        <Label text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtUsuario" promptText="Nombre de usuario" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <PasswordField fx:id="txtContrasena" promptText="Contraseña" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    </GridPane>

    <Label fx:id="lblMensaje" textFill="RED" wrapText="true" />

    <VBox alignment="CENTER" spacing="10.0">
        <Button fx:id="btnIniciarSesion" defaultButton="true" onAction="#onIniciarSesion" prefWidth="180.0" text="Iniciar sesión" />
        <Button fx:id="btnSalir" cancelButton="true" onAction="#onSalir" prefWidth="180.0" text="Salir" />
    </VBox>

    <Hyperlink onAction="#onIrARegistro" text="¿No tienes cuenta? Regístrate aquí" />
</VBox>
